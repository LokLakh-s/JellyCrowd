<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Isolated companion assembly holding ONLY the native media-segment provider (Skip Outro), which
    references Jellyfin's IMediaSegmentProvider. Jellyfin 12 moved those segment types to different
    assemblies (a breaking change vs the 10.11 SDK this targets), so on 12 loading this type throws.
    Keeping it OUT of the main plugin assembly means the main plugin still loads fully on 12 — the main
    registrator loads this type by reflection inside a try/catch, so skip-outro simply turns itself off
    on an incompatible runtime. Not listed in meta.json's "assemblies" (so Jellyfin never scans it).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: the main plugin assembly is loaded separately at runtime, don't copy it here. -->
    <ProjectReference Include="..\Jellyfin.Plugin.JellyCrowd\Jellyfin.Plugin.JellyCrowd.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Ship the built companion as lib/<name>.dll.bin — a subfolder AND a non-".dll" extension — which is the
    layout every packaging path then reproduces.

    Jellyfin enumerates "*.dll" under the plugin folder and loads each one it finds. This companion
    implements IMediaSegmentProvider against the 10.11 SDK; Jellyfin 12 moved those types, so loading it
    there throws a TypeLoadException and the host disables the WHOLE plugin, not just Skip Outro. Two
    defences that look sufficient are not: meta.json's "assemblies" allowlist is rewritten to [] ("scan
    everything") by an install from a repository manifest, and the walk is RECURSIVE, so a plain subfolder
    is scanned too (measured against 12.1). Only the extension takes the file out of that glob, and
    reflection loads it by path regardless of what it is called.
    The main project builds first (this one depends on it), so its output folder already exists.
  -->
  <Target Name="CopyToMainPluginOutput" AfterTargets="Build">
    <PropertyGroup>
      <_JcPluginOutput>$(MSBuildProjectDirectory)/../Jellyfin.Plugin.JellyCrowd/bin/$(Configuration)/net9.0</_JcPluginOutput>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(_JcPluginOutput)/lib/$(TargetFileName).bin"
          SkipUnchangedFiles="true" />
    <!-- An incremental build over a tree that predates this layout still has an old ".dll" copy that every
         packaging path would pick up, so a developer would ship the very file that disables the plugin on
         Jellyfin 12. Clean both past locations up rather than rely on anyone remembering to wipe bin/. -->
    <Delete Files="$(_JcPluginOutput)/$(TargetFileName);$(_JcPluginOutput)/lib/$(TargetFileName)" />
  </Target>

</Project>
