<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyCrowd</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JellyCrowd</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- Copy NuGet runtime dependencies (MailKit/MimeKit/BouncyCastle) into the build output so the
         release packaging bundles them in the plugin zip; without this a library build leaves them in
         the NuGet cache and SMTP fails at runtime with "Could not load file or assembly 'MailKit'". -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only seams (e.g. TmdbClient's overridable base URL for WireMock integration tests). -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.JellyCrowd.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled at runtime (copied into the plugin zip) for robust SMTP: 465/587, STARTTLS, and
         optional acceptance of self-signed/expired certificates. -->
    <PackageReference Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Used only to build the JObject payload for the File Transformation plugin (header injection).
         Provided at runtime by the host / File Transformation; compile-time reference only. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Read the Playback Reporting plugin's SQLite database (historical-playback import). Microsoft.Data.Sqlite
         + SQLitePCLRaw + the native e_sqlite3 are all provided by the Jellyfin host at runtime, so the runtime
         asset is excluded (compile-time reference only — never bundled, so no version conflict). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>
